# App
APP_NAME=agentops
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080

# Database
DATABASE_URL=postgresql+asyncpg://agentops:agentops@localhost:5432/agentops
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM (for LLM Judge scorer)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Evaluation
EVAL_MAX_CONCURRENT=5
EVAL_OUTPUT_DIR=./eval_output

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
